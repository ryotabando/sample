# scan コマンド実行用サンプル
# cp .env.scan-sample .env

# YOLO + LLM ハイブリッドモードを使用
LVM_SERVICE=yolo_hybrid

# LM Studio のエンドポイント（起動したまま使用）
LM_STUDIO_API_BASE=http://localhost:1234/v1

# YOLO で画像解析するためのビジョンモデル（LM Studio でロードするモデル名）
LM_STUDIO_MODEL=llava-llama-3-8b-v1_1

# --diary オプションで観察日記を生成するテキストモデル（同じく LM Studio でロード）
LLM_MODEL=mistral-7b-instruct

# YOLO モデル（初回実行時に自動ダウンロード）
YOLO_MODEL=yolov8s-seg.pt

# OpenAI は使用しないため空欄のままで OK
OPENAI_API_KEY=
