# =============================================================
# Plant Analysis - Environment Variables
# コピーして .env にリネームし、値を設定してください。
# cp .env.example .env
# =============================================================

# ------------------------------------------------------------------
# LVM_SERVICE: 使用する解析エンジンを選択
#   mock        : テスト用モック（LM Studio・YOLO 不要）
#   lm_studio   : LM Studio のビジョンモデルを使用
#   openai      : OpenAI GPT-4 Vision を使用
#   yolo_hybrid : YOLO + LLM ハイブリッド（精度重視）
# ------------------------------------------------------------------
LVM_SERVICE=mock

# ------------------------------------------------------------------
# LM Studio 設定 (LVM_SERVICE=lm_studio / yolo_hybrid 時に使用)
# ------------------------------------------------------------------
LM_STUDIO_API_BASE=http://localhost:1234/v1
LM_STUDIO_MODEL=llava-llama-3-8b-v1_1

# ------------------------------------------------------------------
# LLM テキスト生成モデル (LVM_SERVICE=yolo_hybrid 時に使用)
# ------------------------------------------------------------------
LLM_MODEL=mistral-7b-instruct

# ------------------------------------------------------------------
# YOLO モデル (LVM_SERVICE=yolo_hybrid 時に使用)
#   yolov8n-seg.pt : nano  (高速・低精度)
#   yolov8s-seg.pt : small (推奨バランス)
#   yolov8m-seg.pt : medium
#   yolov8l-seg.pt : large (高精度・低速)
# ------------------------------------------------------------------
YOLO_MODEL=yolov8s-seg.pt

# ------------------------------------------------------------------
# OpenAI API キー (LVM_SERVICE=openai 時に使用)
# ------------------------------------------------------------------
OPENAI_API_KEY=
