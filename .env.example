# =============================================================
# Plant Analysis - Environment Variables
# コピーして .env にリネームし、値を設定してください。
# cp .env.example .env
# =============================================================

# ------------------------------------------------------------------
# LVM_SERVICE: 使用する解析エンジンを選択
#   mock        : テスト用モック（LM Studio・YOLO 不要）
#   lm_studio   : LM Studio のビジョンモデルを使用
#   openai      : OpenAI GPT-4 Vision を使用
#   yolo_hybrid : YOLO + LLM ハイブリッド（精度重視）
# ------------------------------------------------------------------
LVM_SERVICE=mock

# ------------------------------------------------------------------
# LM Studio 設定 (LVM_SERVICE=lm_studio / yolo_hybrid 時に使用)
# ------------------------------------------------------------------
LM_STUDIO_API_BASE=http://localhost:1234/v1
LM_STUDIO_MODEL=llava-llama-3-8b-v1_1

# ------------------------------------------------------------------
# LLM テキスト生成モデル
#   lm_studio   : LM Studio の日記生成モデル（ビジョン不要のテキストモデルでOK）
#   openai      : OpenAI の日記生成モデル
#   yolo_hybrid : YOLO + LLM ハイブリッド時の日記生成モデル
# ------------------------------------------------------------------
LLM_MODEL=mistral-7b-instruct

# OpenAI使用時の日記生成モデル (LVM_SERVICE=openai 時に使用)
#   gpt-4o-mini : 安価・十分な精度（推奨）
#   gpt-4o      : 高精度・高コスト
OPENAI_DIARY_MODEL=gpt-4o-mini

# ------------------------------------------------------------------
# YOLO モデル (LVM_SERVICE=yolo_hybrid 時に使用)
#   yolov8n-seg.pt : nano  (高速・低精度)
#   yolov8s-seg.pt : small (推奨バランス)
#   yolov8m-seg.pt : medium
#   yolov8l-seg.pt : large (高精度・低速)
# ------------------------------------------------------------------
YOLO_MODEL=yolov8s-seg.pt

# ------------------------------------------------------------------
# OpenAI API キー (LVM_SERVICE=openai 時に使用)
# ------------------------------------------------------------------
OPENAI_API_KEY=

# =============================================================
# モード別クイック設定
# 使いたいモードのブロックをそのままコピーして .env に貼り付け
# =============================================================

# --- LM Studio モード ---
# LVM_SERVICE=lm_studio
# LM_STUDIO_API_BASE=http://localhost:1234/v1
# LM_STUDIO_MODEL=llava-v1.6-mistral-7b    # 画像解析（ビジョンモデル必須）
# LLM_MODEL=mistral-7b-instruct             # 日記生成（テキストモデルでOK）

# --- OpenAI モード ---
# LVM_SERVICE=openai
# OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxx
# OPENAI_DIARY_MODEL=gpt-4o-mini            # 日記生成モデル（省略可、デフォルト gpt-4o-mini）

# --- YOLO + LLM ハイブリッドモード ---
# LVM_SERVICE=yolo_hybrid
# LM_STUDIO_API_BASE=http://localhost:1234/v1
# LLM_MODEL=mistral-7b-instruct
# YOLO_MODEL=yolov8s-seg.pt
